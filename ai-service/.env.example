# ==============================================================
# WildShield AI - Python AI service environment configuration
# Copy to .env and adjust values. NEVER commit .env
# ==============================================================

AI_ENV=development
AI_HOST=0.0.0.0
AI_PORT=8000

# --- Model configuration ---
# Replace with a custom-trained wildlife/security model when available.
# A stock COCO checkpoint cannot reliably detect weapons/traps/species.
MODEL_PATH=models/yolo11n.pt
CONFIDENCE_THRESHOLD=0.40
IOU_THRESHOLD=0.45
FRAME_INTERVAL=10
DEVICE=cpu

# --- Video limits ---
MAX_VIDEO_SIZE_MB=200

# --- Demo mode (sample results must always be labeled "DEMO DATA") ---
DEMO_MODE=false

# --- CORS (origins allowed to call this service) ---
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
