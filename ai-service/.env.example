# ==============================================================
# WildShield AI - Python AI service environment configuration
# Copy to .env and adjust values. NEVER commit .env
# ==============================================================

AI_ENV=development
AI_HOST=0.0.0.0
AI_PORT=8000

# --- Model configuration ---
# Replace with a custom-trained wildlife/security model when available.
# A stock COCO checkpoint cannot reliably detect weapons/traps/species.
MODEL_PATH=models/yolo11n.pt
CONFIDENCE_THRESHOLD=0.40
IOU_THRESHOLD=0.45
FRAME_INTERVAL=10
# auto = use CUDA GPU when available, otherwise CPU. Never hard-code "cuda".
DEVICE=auto

# --- VideoMAE temporal action recognition ---
# Pretrained backbone. This is a GENERIC video representation model and CANNOT
# recognize Wildshield-specific classes (poaching, capture, weapon_use, ...)
# until a fine-tuned checkpoint is provided.
VIDEOMAE_MODEL_NAME=MCG-NJU/videomae-base
# Path to a Wildshield-specific fine-tuned checkpoint. Leave empty to run in
# PRETRAINED / MODEL-DEVELOPMENT mode (no custom class predictions are made).
VIDEOMAE_CHECKPOINT=
# Number of clip frames sampled and fed to VideoMAE (temporal sampling).
VIDEOMAE_NUM_FRAMES=16
# Minimum confidence for the action class to contribute to the threat analysis.
VIDEOMAE_CONFIDENCE_THRESHOLD=0.5
# Load VideoMAE at startup (background) instead of lazily on first analysis.
VIDEOMAE_EAGER_LOAD=false

# --- Video limits ---
MAX_VIDEO_SIZE_MB=200

# --- Demo mode (sample results must always be labeled "DEMO DATA") ---
DEMO_MODE=false

# --- CORS (origins allowed to call this service) ---
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
