# ==============================================================
# WildShield AI - Backend environment configuration (example)
# Copy this file to .env and adjust values. NEVER commit .env
# ==============================================================

# --- Server ---
NODE_ENV=development
PORT=5000

# Serve ../frontend from the backend origin (single-origin demo). true|false
STATIC_FRONTEND=true

# --- MongoDB ---
# Local dev default. For Docker: mongodb://mongo:27017/wildshield
# For Atlas: mongodb+srv://<user>:<password>@<cluster>/wildshield
MONGODB_URI=mongodb://localhost:27017/wildshield

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5500

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- AI service (used from Phase 7 integration onwards) ---
AI_SERVICE_URL=http://localhost:8000

# --- Authentication (required from Phase 3) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- File storage (used from Phase 4) ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=200

# --- Demo mode ---
# When true, sample analysis results are returned but MUST be labeled "DEMO DATA"
DEMO_MODE=false
